# Database - PostgreSQL for production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

JWT_SECRET=payo-dev-secret-change-in-production-minimum-64-chars-long-random-string
SESSION_EXPIRY_HOURS=24
SESSION_REMEMBER_ME_DAYS=7
TRIAL_DAYS=14
PAYONEER_EMAIL=admin@payo.com
APP_URL=http://localhost:3000
CRON_SECRET=payo-cron-secret-change-me

# Supabase
SUPABASE_URL=[INSERT YOUR SUPABASE URL]
SUPABASE_ANON_KEY=[INSERT YOUR SUPABASE ANON KEY]

# OpenRouter AI
OPENROUTER_API_KEY=[INSERT YOUR OPENROUTER KEY]
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Email Provider (Resend fallback)
RESEND_API_KEY=
